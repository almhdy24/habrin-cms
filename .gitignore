# ============================================================
# Pico JSON CMS - Runtime Data
# ============================================================

# Ignore all generated CMS content
/content/*
!/content/.gitkeep
!/content/.htaccess

# Runtime secrets and install markers
/content/.admin.php
/content/.installed

# Temporary files and locks
*.tmp
*.tmp.*
*.lock

# Runtime logs
/logs/*
!/logs/.gitkeep
!/logs/.htaccess

# Backups
/backups/*
!/backups/.gitkeep
!/backups/.htaccess

# User media uploads
/assets/uploads/*
!/assets/uploads/.gitkeep
!/assets/uploads/.htaccess

# ============================================================
# Dependencies & Tests
# ============================================================

/vendor/
.phpunit.result.cache
.phpunit.cache/

# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*

# ============================================================
# OS / Editor
# ============================================================

.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/